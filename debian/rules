#!/usr/bin/make -f
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
DIFFTASTIC_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/[-~].*//')
UPSTREAM_URL := https://github.com/Wilfred/difftastic

%:
	dh $@

override_dh_auto_configure:

# Upstream ships prebuilt binaries only; the tarballs are flat (a single
# `difft`) and the version is in the URL, not the filename. The man page
# (difft.1, generated by upstream from difft.1.md) is only in the source
# tree, so it is fetched separately from the same tag.
override_dh_auto_build:
	@arch="$(DEB_HOST_ARCH)"; \
	case "$$arch" in \
		amd64) DIFFT_TARGET="x86_64-unknown-linux-musl" ;; \
		arm64) DIFFT_TARGET="aarch64-unknown-linux-gnu" ;; \
		*) echo "Unsupported architecture: $$arch"; exit 1 ;; \
	esac; \
	DIFFT_RELEASE="difft-$(DIFFTASTIC_VERSION)-$$DIFFT_TARGET"; \
	echo "Downloading difft-$$DIFFT_TARGET.tar.gz for $(DIFFTASTIC_VERSION)..."; \
	wget -q "$(UPSTREAM_URL)/releases/download/$(DIFFTASTIC_VERSION)/difft-$$DIFFT_TARGET.tar.gz" -O "$$DIFFT_RELEASE.tar.gz"; \
	mkdir -p "$$DIFFT_RELEASE"; \
	tar -xf "$$DIFFT_RELEASE.tar.gz" -C "$$DIFFT_RELEASE"; \
	rm -f "$$DIFFT_RELEASE.tar.gz"; \
	if [ -f difft.1 ]; then \
		cp difft.1 "$$DIFFT_RELEASE/difft.1"; \
	else \
		wget -q "https://raw.githubusercontent.com/Wilfred/difftastic/$(DIFFTASTIC_VERSION)/difft.1" -O "$$DIFFT_RELEASE/difft.1"; \
	fi; \
	echo "$$DIFFT_RELEASE" > .difft_release_name

override_dh_auto_install:
	@DIFFT_RELEASE=$$(cat .difft_release_name); \
	install -D -m 755 "$$DIFFT_RELEASE/difft" debian/difftastic/usr/bin/difft; \
	install -D -m 644 "$$DIFFT_RELEASE/difft.1" debian/difftastic/usr/share/man/man1/difft.1

override_dh_gencontrol:
	@arch="$(DEB_HOST_ARCH)"; \
	case "$$arch" in \
		arm64) EXTRA=", libc6 (>= 2.18), libgcc-s1" ;; \
		*)     EXTRA="" ;; \
	esac; \
	dh_gencontrol -- -V"dist:Depends=$$EXTRA"

override_dh_auto_test:

override_dh_auto_clean:
	@if [ -f .difft_release_name ]; then \
		DIFFT_RELEASE=$$(cat .difft_release_name); \
		rm -rf "$$DIFFT_RELEASE" .difft_release_name || true; \
	fi

override_dh_strip:

override_dh_shlibdeps:
